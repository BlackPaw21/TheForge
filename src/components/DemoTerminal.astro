---
// src/components/DemoTerminal.astro
---

<section id="demo" class="section">
  <div class="container">
    <p class="section-label reveal">LIVE DEMO</p>
    <h2 class="section-title reveal">TOOL IN<br />ACTION</h2>
    <div class="demo-window reveal">
      <div class="demo-titlebar">
        <span class="demo-dot demo-dot--red"></span>
        <span class="demo-dot demo-dot--yellow"></span>
        <span class="demo-dot demo-dot--green"></span>
        <span class="demo-title">forge@hellcat — 80×24</span>
      </div>
      <div class="demo-body" id="demo-body">
        <div class="demo-line demo-prompt">
          <span class="demo-prompt-text">root@forge:~$</span>
          <span class="demo-cmd" id="demo-cmd"></span>
          <span class="demo-cursor blink">▊</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #demo {
    background: transparent;
  }
  .demo-window {
    max-width: 720px;
    margin: 0 auto;
    border: 1px solid var(--border);
    background: rgba(5, 5, 5, 0.95);
    font-family: var(--font-mono);
    font-size: 13px;
    overflow: hidden;
  }
  .demo-titlebar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .demo-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
  }
  .demo-dot--red { background: #ff5f56; }
  .demo-dot--yellow { background: #ffbd2e; }
  .demo-dot--green { background: #27c93f; }
  .demo-title {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 1px;
    margin-left: 4px;
  }
  .demo-body {
    padding: 20px 24px;
    min-height: 200px;
  }
  .demo-line {
    line-height: 1.9;
    white-space: pre-wrap;
    font-weight: 500;
    min-height: 1.9em;
  }
  .demo-prompt-text {
    color: var(--blood);
    font-weight: 700;
  }
  .demo-cmd {
    color: var(--text);
  }
  .demo-output {
    color: var(--muted);
    line-height: 1.9;
    white-space: pre-wrap;
    font-weight: 500;
    min-height: 1.9em;
    padding-left: 0;
  }
  .demo-output .ok {
    color: #27c93f;
  }
  .demo-output .highlight {
    color: var(--blood);
    font-weight: 800;
  }
  .demo-output .dim {
    color: #555;
  }
  .demo-cursor {
    color: var(--text);
    animation: blink 1s step-end infinite;
    margin-left: 2px;
  }
  .demo-prompt-end {
    margin-top: 8px;
  }
</style>

<script>
  const cmd = document.getElementById('demo-cmd')!;
  const body = document.getElementById('demo-body')!;

  const COMMAND = 'hellcat --hash-mode md5 --target acme-corps-hashes.txt';
  const OUTPUT = [
    '',
    '\x1b[2m╔══════════════════════════════════════╗\x1b[0m',
    '\x1b[2m║\x1b[0m  \x1b[31mHellCat\x1b[0m v1.2 — HashCat Automation  \x1b[2m║\x1b[0m',
    '\x1b[2m║\x1b[0m  Mode: \x1b[33mMD5\x1b[0m ($1$ salt)                \x1b[2m║\x1b[0m',
    '\x1b[2m║\x1b[0m  Hashes: \x1b[33m142\x1b[0m loaded, \x1b[33m0\x1b[0m skipped       \x1b[2m║\x1b[0m',
    '\x1b[2m║\x1b[0m  Device: \x1b[33mNVIDIA RTX 4090\x1b[0m             \x1b[2m║\x1b[0m',
    '\x1b[2m╚══════════════════════════════════════╝\x1b[0m',
    '',
    'Session..........: \x1b[32mactive\x1b[0m',
    'Speed.#1.........: \x1b[33m42.5 GH/s\x1b[0m  \x1b[2m(42.5s remaining)\x1b[0m',
    'Progress.........: \x1b[33m96/142\x1b[0m  \x1b[2m(67.61%)\x1b[0m',
    '',
    '\x1b[32m[ OK ]\x1b[0m  Cracking complete — \x1b[32m100%\x1b[0m',
    '\x1b[32m[ OK ]\x1b[0m  \x1b[37mRecovered\x1b[0m \x1b[31m138/142\x1b[0m passwords',
    '\x1b[32m[ OK ]\x1b[0m  Results written to \x1b[33mcracked_acme.txt\x1b[0m',
    '',
    '\x1b[31mroot@forge:~$\x1b[0m \x1b[37mcat cracked_acme.txt | head -3\x1b[0m',
    '\x1b[31madmin\x1b[0m:\x1b[33mP@ssw0rd2024!\x1b[0m',
    '\x1b[31mroot\x1b[0m:\x1b[33mqwerty12345\x1b[0m',
    '\x1b[31mdb_admin\x1b[0m:\x1b[33mSummer2024!\x1b[0m',
    '',
  ];

  // ANSI to HTML
  function ansi(html: string): string {
    return html
      .replace(/\x1b\[31m/g, '<span class="highlight">')
      .replace(/\x1b\[32m/g, '<span class="ok">')
      .replace(/\x1b\[33m/g, '<span style="color:#ffbd2e">')
      .replace(/\x1b\[37m/g, '<span style="color:var(--text)">')
      .replace(/\x1b\[2m/g, '<span class="dim">')
      .replace(/\x1b\[0m/g, '</span>');
  }

  function sleep(ms: number) {
    return new Promise(r => setTimeout(r, ms));
  }

  async function runDemo() {
    // Type the command
    await sleep(600);
    for (let i = 1; i <= COMMAND.length; i++) {
      cmd.textContent = COMMAND.slice(0, i);
      await sleep(30 + Math.random() * 20);
    }

    await sleep(400);

    // Show output lines
    for (const line of OUTPUT) {
      const el = document.createElement('div');
      el.className = 'demo-line demo-output';
      el.innerHTML = ansi(line);
      body.appendChild(el);
      await sleep(line.length > 50 ? 100 : 40);
    }

    // Final prompt
    await sleep(300);
    const final = document.createElement('div');
    final.className = 'demo-line demo-prompt demo-prompt-end';
    final.innerHTML = '<span class="demo-prompt-text">root@forge:~$</span> <span class="demo-cursor blink">▊</span>';
    body.appendChild(final);

    // Scroll to bottom
    const section = document.getElementById('demo');
    if (section) section.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // Trigger on scroll into view
  const demoBody = document.getElementById('demo-body')!;
  let played = false;
  const observer = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting && !played) {
      played = true;
      observer.disconnect();
      runDemo();
    }
  }, { threshold: 0.3 });
  observer.observe(demoBody);
</script>
