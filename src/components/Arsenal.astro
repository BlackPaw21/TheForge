---
// src/components/Arsenal.astro
import projects from '../data/projects.json';
---

<section id="arsenal" class="section">
  <div class="container">
    <p class="section-label reveal">02 / ARSENAL</p>
    <h2 class="section-title reveal">PROJECTS</h2>
    <div class="arsenal-grid">
      {projects.map((p, idx) => (
        <div class="project-card reveal" style={`--idx: ${idx}`}>
          <div class="project-card-inner">
            <div class="project-header">
              <span class="project-idx">[{String(idx + 1).padStart(2, '0')}]</span>
              <h3 class="project-name">{p.name}</h3>
            </div>
            <p class="project-tagline">{p.tagline}</p>
            <p class="project-desc">{p.description}</p>
            <div class="project-tags">
              {p.tags.map(t => <span class="tag">{t}</span>)}
            </div>
            <div class="project-footer">
              <a href={p.repo_url} target="_blank" rel="noopener" class="project-link">
                <span class="project-link-label">cd forge/arsenal &amp;&amp; cat</span>
                <span class="project-link-name">{p.name.toLowerCase().replace(/\s+/g, '-')}.md</span>
                <span class="project-link-arrow">→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .arsenal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 12px;
  }

  .project-card {
    border: 1px solid var(--border);
    background: var(--surface);
    transition: border-color 300ms ease, background 300ms ease,
                box-shadow 300ms ease, transform 300ms ease;
    position: relative;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 400ms ease, transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
                border-color 300ms ease, background 300ms ease,
                box-shadow 300ms ease;
  }
  .project-card.visible {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--idx, 0) * 80ms);
  }
  .project-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 0;
    background: var(--blood);
    transition: width 200ms ease;
  }
  .project-card:hover {
    border-color: var(--blood);
    background: var(--elevated);
    box-shadow: 0 0 30px rgba(255, 32, 32, 0.12),
                inset 0 0 30px rgba(255, 32, 32, 0.03);
    transform: translateY(-2px);
  }
  .project-card:hover::before { width: 3px; }
  .project-card:hover .project-idx { color: var(--blood); }

  .project-card-inner {
    padding: 24px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 12px;
  }
  .project-idx {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 1px;
    min-width: 28px;
  }
  .project-name {
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--text);
  }

  .project-tagline {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.5;
    margin-bottom: 8px;
    font-style: italic;
  }
  .project-desc {
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 16px;
  }
  .project-tags .tag {
    font-size: 11px;
    padding: 3px 8px;
  }

  .project-footer {
    border-top: 1px solid var(--border);
    padding-top: 14px;
    margin-top: auto;
  }

  .project-link {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--blood);
    text-transform: uppercase;
    transition: letter-spacing 200ms ease;
  }
  .project-link-label {
    color: var(--muted);
    font-weight: 500;
  }
  .project-link-name {
    color: var(--text);
    font-weight: 700;
  }
  .project-link-arrow {
    transition: transform 200ms ease;
  }
  .project-link:hover { letter-spacing: 1.5px; }
  .project-link:hover .project-link-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 600px) {
    .arsenal-grid { grid-template-columns: 1fr; gap: 10px; }
    .project-card-inner { padding: 20px; }
    .project-name { font-size: 16px; }
    .project-desc { font-size: 13px; }
    .project-tagline { font-size: 12px; }
    .project-link { font-size: 10px; flex-wrap: wrap; }
    .project-link-name { word-break: break-all; }
  }
</style>
