---
// src/components/About.astro
---

<section id="about" class="section">
  <div class="container">
    <p class="section-label reveal">01 / ABOUT</p>
    <h2 class="section-title reveal">WHO IS<br />BLACKPAW</h2>
    <div class="about-bio reveal">
      <p>
        Offensive security operator and toolsmith. I build things that break
        other things — then write about how they worked.
      </p>
      <p>
        Windows internals mods (Windhawk), web tools, RF sensing platforms,
        and autonomous infra. Self-taught, production-depth, solo.
      </p>
      <p>
        Dark aesthetics, clean interactions, and tools that actually do
        something. If it runs smooth and has teeth — that's the goal.
      </p>
    </div>
    <div class="about-stats reveal">
      <div class="stat">
        <span class="stat-num" id="stat-projects">12</span>
        <span class="stat-label">Projects</span>
      </div>
      <div class="stat">
        <span class="stat-num" id="stat-tools">8</span>
        <span class="stat-label">Tools Shipped</span>
      </div>
    </div>
  </div>
</section>

<style>
  .about-bio {
    max-width: 600px;
  }
  .about-bio p {
    color: var(--muted);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.9;
    margin-bottom: 16px;
  }
  .about-stats {
    display: flex;
    gap: 40px;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
    max-width: 600px;
  }
  .stat-num {
    display: block;
    font-family: var(--font-display);
    font-size: 48px;
    letter-spacing: 2px;
    color: var(--blood);
    line-height: 1;
  }
  .stat-label {
    display: block;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 6px;
  }

  @media (max-width: 600px) {
    .about-bio p { font-size: 15px; line-height: 1.8; }
    .about-stats { gap: 16px; flex-wrap: wrap; justify-content: center; }
    .stat { text-align: center; flex: 1; min-width: 80px; }
    .stat-num { font-size: 32px; }
    .stat-label { font-size: 11px; letter-spacing: 1px; }
  }

  @media (max-width: 400px) {
    .about-stats { gap: 12px; }
    .stat-num { font-size: 28px; }
    .stat { min-width: 70px; }
  }
</style>

<script>
  const STATS = { projects: 12, tools: 8 };
  function animateCounter(el: HTMLElement, target: number, duration: number = 1200) {
    el.textContent = '0';
    const start = performance.now();
    const tick = (now: number) => {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      el.textContent = String(Math.floor(progress * target));
      if (progress < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
  const statsSection = document.querySelector('.about-stats') as HTMLElement;
  let counted = false;
  const observer = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting && !counted) {
      counted = true;
      animateCounter(document.getElementById('stat-projects')!, STATS.projects);
      animateCounter(document.getElementById('stat-tools')!, STATS.tools);
    }
  }, { threshold: 0.5 });
  observer.observe(statsSection);
</script>
